# Reverse proxy + HTTPS automático (Let's Encrypt) de PreztiaOS en producción.
# DOMAIN y ACME_EMAIL llegan como variables de entorno (env_file .env.prod en el servicio caddy).
#
#   {$DOMAIN} / www.{$DOMAIN}  → landing estática (file_server desde /srv/landing)
#   api.{$DOMAIN}              → API NestJS (reverse_proxy a api:3000, red interna)
#
# Caddy obtiene y renueva los certificados TLS solo; no hay que tocar nada.

{
	email {$ACME_EMAIL}
}

# ---- Landing pública (raíz + www) ----
{$DOMAIN}, www.{$DOMAIN} {
	encode zstd gzip
	root * /srv/landing
	file_server

	# El documento HTML se revalida siempre (los CSS/JS van versionados con ?v=): un deploy
	# de la landing se ve al instante, sin quedar servida una mezcla de HTML nuevo + CSS viejo.
	@doc path / /index.html
	header @doc Cache-Control "no-cache"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# ---- API ----
api.{$DOMAIN} {
	encode zstd gzip
	# Access log (JSON a stdout): permite verificar si una petición LLEGÓ y con qué status
	# (p. ej. los POST de Meta a /webhooks/whatsapp o de Telegram a /webhooks/telegram/…) sin
	# depender de que la API loguee.
	log

	# Webhook de Telegram (ADR #40): solo desde las redes de la Bot API. Es defensa en profundidad:
	# la autenticidad ya la prueba el secret token de cada bot en la API (403 si no coincide).
	# Rangos publicados por Telegram: https://core.telegram.org/bots/webhooks
	# Requiere que Caddy vea la IP REAL del cliente (el access log trae `remote_ip`). Si Telegram
	# amplía sus rangos, el botón "Verificar" de la zona mostrará un 403 como último error.
	@telegram_outside {
		path /webhooks/telegram/*
		not remote_ip 149.154.160.0/20 91.108.4.0/22
	}
	respond @telegram_outside 403

	reverse_proxy api:3010
}

# ---- App web (export estático de Expo Router, output: "static") ----
# Sirve el build de apps/mobile (expo export -p web) copiado a /srv/app. Expo Router genera un
# .html por ruta; el fallback a /index.html cubre las rutas resueltas en el cliente.
app.{$DOMAIN} {
	encode zstd gzip
	root * /srv/app
	try_files {path} {path}.html {path}/ /index.html
	file_server

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
